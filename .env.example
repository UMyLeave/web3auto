# 专用小额钱包私钥。不要使用主钱包，不要提交真实值。
PRIVATE_KEY=

PORT=3000
HOST=127.0.0.1
AUTO_EXECUTE=false

# 管理页面登录。密码至少 12 个字符，建议使用密码管理器生成 20 位以上随机密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SESSION_HOURS=12
# 只有在 HTTPS 反向代理部署完成后才改成 true。
AUTH_COOKIE_SECURE=false

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=
