# 用于签名撤流动性和换币交易的钱包私钥。
# 建议使用专用小额钱包，不要使用主钱包私钥。
PRIVATE_KEY=

# 本地网页服务端口。
PORT=3000
# 默认只监听本机，避免交易控制接口暴露到局域网或公网。
HOST=127.0.0.1

# 是否真的执行链上撤出和换币：
# false = 只运行/检查，不自动发交易；true = 满足条件后自动发交易。
AUTO_EXECUTE=true

# 是否允许“初始化流动性”页面广播授权和加池交易。
# 与 AUTO_EXECUTE 独立；false 时加池页面只能进行链上只读预检。
LIQUIDITY_EXECUTE=true

# OKX DEX API 凭证，在 OKX 开发者平台创建。
# 撤退后的兑换和初始化流动性的稳定币自动分配都会在各自独立模块中使用。
# 这些值只放在服务端 .env，不要放到前端或提交到 Git。
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=

# 部分 OKX 项目需要填写项目 ID；不需要时保持为空。
OKX_PROJECT_ID=
